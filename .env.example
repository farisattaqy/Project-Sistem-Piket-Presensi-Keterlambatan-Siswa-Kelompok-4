# Environment variables for Sistem Piket & Presensi Keterlambatan Siswa

# Server Port (default 3000)
PORT=3000

# Node Environment: 'development' or 'production'
NODE_ENV=production

# Session Secret (ganti dengan string acak dan panjang untuk produksi)
SESSION_SECRET=ubah-dengan-string-rahasia-yang-kuat-dan-acak-minimal-32-karakter

# Database URL Prisma (SQLite)
DATABASE_URL="file:./dev.db"
