<!-- Admin - Kelola Kelas -->
<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Data Kelas</h1>
    <p class="text-sm text-gray-500">Kelola rombongan belajar dan wali kelas</p>
  </div>

  <!-- Form Tambah Kelas -->
  <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
    <h3 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
      <i data-lucide="plus-circle" class="w-4 h-4 text-blue-500"></i> Tambah Kelas Baru
    </h3>
    <form action="/admin/classes" method="POST" class="flex flex-col sm:flex-row gap-3">
      <input type="text" name="namaKelas" required placeholder="Nama Kelas (contoh: X RPL 3)"
        class="flex-1 px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
      <input type="text" name="waliKelas" required placeholder="Wali Kelas (contoh: Ibu Sari, S.Pd)"
        class="flex-1 px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
      <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-medium hover:bg-blue-700 transition shadow-sm flex items-center gap-2">
        <i data-lucide="plus" class="w-4 h-4"></i> Tambah
      </button>
    </form>
  </div>

  <!-- Daftar Kelas -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% classes.forEach(c => { %>
      <div class="card-hover bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
        <div class="flex items-start justify-between mb-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center">
              <i data-lucide="school" class="w-5 h-5 text-blue-500"></i>
            </div>
            <div>
              <h4 class="font-semibold text-gray-800"><%= c.namaKelas %></h4>
              <p class="text-xs text-gray-400"><%= c.waliKelas %></p>
            </div>
          </div>
          <span class="badge badge-info"><%= c._count.students %> siswa</span>
        </div>

        <!-- Edit Form (inline) -->
        <details class="mt-3">
          <summary class="text-xs text-blue-600 cursor-pointer hover:underline">Edit / Hapus</summary>
          <form action="/admin/classes/<%= c.id %>" method="POST" class="mt-3 space-y-2">
            <input type="text" name="namaKelas" value="<%= c.namaKelas %>" required
              class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-blue-500">
            <input type="text" name="waliKelas" value="<%= c.waliKelas %>" required
              class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-blue-500">
            <div class="flex gap-2">
              <button type="submit" class="px-3 py-1.5 bg-blue-600 text-white rounded-lg text-xs font-medium hover:bg-blue-700 transition">
                Simpan
              </button>
            </div>
          </form>
          <form action="/admin/classes/<%= c.id %>/delete" method="POST" class="mt-2" onsubmit="return confirm('Yakin ingin menghapus kelas ini?')">
            <button type="submit" class="px-3 py-1.5 bg-red-50 text-red-600 rounded-lg text-xs font-medium hover:bg-red-100 transition">
              <i data-lucide="trash-2" class="w-3 h-3 inline"></i> Hapus Kelas
            </button>
          </form>
        </details>
      </div>
    <% }); %>
  </div>
</div>

<script>lucide.createIcons();</script>
