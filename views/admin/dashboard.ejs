<!-- Admin Dashboard - Live Monitoring Keterlambatan -->
<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Dashboard Admin</h1>
      <p class="text-sm text-gray-500">Live monitoring keterlambatan & kedisiplinan siswa</p>
    </div>
    <span class="text-xs text-gray-400 bg-white px-3 py-1.5 rounded-lg border inline-flex items-center gap-1">
      <i data-lucide="clock" class="w-3 h-3"></i>
      <%= new Date().toLocaleTimeString('id-ID') %>
    </span>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="card-hover bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Total Siswa</p>
          <p class="text-3xl font-bold text-gray-800 mt-1"><%= totalSiswa %></p>
        </div>
        <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center">
          <i data-lucide="users" class="w-6 h-6 text-blue-500"></i>
        </div>
      </div>
    </div>

    <div class="card-hover bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Total Kelas</p>
          <p class="text-3xl font-bold text-gray-800 mt-1"><%= totalKelas %></p>
        </div>
        <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center">
          <i data-lucide="school" class="w-6 h-6 text-green-500"></i>
        </div>
      </div>
    </div>

    <div class="card-hover bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Terlambat Hari Ini</p>
          <p class="text-3xl font-bold text-orange-600 mt-1"><%= terlambatHariIni %></p>
        </div>
        <div class="w-12 h-12 bg-orange-50 rounded-xl flex items-center justify-center">
          <i data-lucide="alarm-clock" class="w-6 h-6 text-orange-500"></i>
        </div>
      </div>
    </div>

    <div class="card-hover bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Terlambat Minggu Ini</p>
          <p class="text-3xl font-bold text-red-600 mt-1"><%= terlambatMingguIni %></p>
        </div>
        <div class="w-12 h-12 bg-red-50 rounded-xl flex items-center justify-center">
          <i data-lucide="trending-up" class="w-6 h-6 text-red-500"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Trend Chart (Simple Bar) -->
    <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
      <h3 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
        <i data-lucide="bar-chart-3" class="w-4 h-4 text-blue-500"></i>
        Tren Keterlambatan 7 Hari Terakhir
      </h3>
      <div class="flex items-end gap-2 h-40">
        <% const maxVal = Math.max(...trendData.map(t => t.jumlah), 1); %>
        <% trendData.forEach(t => { %>
          <div class="flex-1 flex flex-col items-center gap-1">
            <span class="text-xs font-bold text-gray-600"><%= t.jumlah %></span>
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-md transition-all duration-500" style="height: <%= Math.max((t.jumlah / maxVal) * 100, 4) %>%"></div>
            <span class="text-[10px] text-gray-400 text-center leading-tight"><%= t.tanggal %></span>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- Distribusi per Kelas -->
    <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
      <h3 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
        <i data-lucide="pie-chart" class="w-4 h-4 text-green-500"></i>
        Distribusi Keterlambatan per Kelas (7 Hari)
      </h3>
      <div class="space-y-3">
        <% const maxKelas = Math.max(...kelasData.map(k => k.jumlahTerlambat), 1); %>
        <% kelasData.forEach(k => { %>
          <div class="flex items-center gap-3">
            <span class="text-xs font-medium text-gray-600 w-20 truncate"><%= k.namaKelas %></span>
            <div class="flex-1 bg-gray-100 rounded-full h-5 overflow-hidden">
              <div class="h-full bg-gradient-to-r from-blue-400 to-blue-600 rounded-full flex items-center justify-end pr-2 transition-all duration-500"
                   style="width: <%= Math.max((k.jumlahTerlambat / maxKelas) * 100, 5) %>%">
                <span class="text-[10px] text-white font-bold"><%= k.jumlahTerlambat %></span>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Top Poin Pelanggaran -->
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm">
      <div class="p-5 border-b border-gray-50">
        <h3 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
          <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-500"></i>
          Top 10 Siswa — Poin Pelanggaran Tertinggi
        </h3>
      </div>
      <div class="divide-y divide-gray-50">
        <% topPelanggaran.forEach((s, i) => { %>
          <div class="flex items-center justify-between px-5 py-3 hover:bg-gray-50 transition">
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold
                <%= i < 3 ? 'bg-red-100 text-red-600' : 'bg-gray-100 text-gray-500' %>">
                <%= i + 1 %>
              </span>
              <div>
                <p class="text-sm font-medium text-gray-800"><%= s.nama %></p>
                <p class="text-[11px] text-gray-400"><%= s.class.namaKelas %></p>
              </div>
            </div>
            <span class="badge <%= s.totalPoin >= 75 ? 'badge-danger' : s.totalPoin >= 50 ? 'badge-warning' : 'badge-info' %>">
              <%= s.totalPoin %> poin
            </span>
          </div>
        <% }); %>
        <% if (topPelanggaran.length === 0) { %>
          <div class="p-8 text-center text-gray-400 text-sm">Belum ada data pelanggaran</div>
        <% } %>
      </div>
    </div>

    <!-- Keterlambatan Hari Ini -->
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm">
      <div class="p-5 border-b border-gray-50">
        <h3 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
          <i data-lucide="clock" class="w-4 h-4 text-blue-500"></i>
          Keterlambatan Hari Ini
        </h3>
      </div>
      <div class="divide-y divide-gray-50">
        <% recentLate.forEach(r => { %>
          <div class="flex items-center justify-between px-5 py-3 hover:bg-gray-50 transition">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-orange-100 flex items-center justify-center">
                <i data-lucide="user" class="w-4 h-4 text-orange-600"></i>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-800"><%= r.student.nama %></p>
                <p class="text-[11px] text-gray-400"><%= r.student.class.namaKelas %> · Telat <%= r.menitTelat %> menit</p>
              </div>
            </div>
            <span class="badge <%= r.statusIzin === 'DIIZINKAN' ? 'badge-success' : 'badge-warning' %>">
              <%= r.statusIzin %>
            </span>
          </div>
        <% }); %>
        <% if (recentLate.length === 0) { %>
          <div class="p-8 text-center text-gray-400 text-sm">
            <i data-lucide="party-popper" class="w-8 h-8 mx-auto mb-2 text-green-400"></i>
            Tidak ada siswa terlambat hari ini 🎉
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>lucide.createIcons();</script>
