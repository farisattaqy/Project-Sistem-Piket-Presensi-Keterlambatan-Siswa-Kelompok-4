<!-- Admin - Aturan Pelanggaran -->
<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Aturan Pelanggaran</h1>
    <p class="text-sm text-gray-500">Konfigurasi katalog bobot poin pelanggaran tata tertib</p>
  </div>

  <!-- Form Tambah -->
  <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
    <h3 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
      <i data-lucide="plus-circle" class="w-4 h-4 text-blue-500"></i> Tambah Aturan Baru
    </h3>
    <form action="/admin/rules" method="POST" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
      <input type="text" name="namaPelanggaran" required placeholder="Nama Pelanggaran"
        class="sm:col-span-2 px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
      <input type="number" name="bobotPoin" required placeholder="Bobot Poin" min="1"
        class="px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
      <input type="text" name="sanksiDefault" required placeholder="Sanksi Default"
        class="px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
      <div class="sm:col-span-4">
        <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-medium hover:bg-blue-700 transition shadow-sm flex items-center gap-2">
          <i data-lucide="plus" class="w-4 h-4"></i> Tambah Aturan
        </button>
      </div>
    </form>
  </div>

  <!-- Tabel Aturan -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-100">
          <tr>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">No</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Pelanggaran</th>
            <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Bobot Poin</th>
            <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Sanksi Default</th>
            <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% rules.forEach((r, i) => { %>
            <tr class="hover:bg-gray-50 transition" id="row-<%= r.id %>">
              <td class="px-5 py-3 text-gray-500"><%= i + 1 %></td>
              <td class="px-5 py-3 font-medium text-gray-800"><%= r.namaPelanggaran %></td>
              <td class="px-5 py-3 text-center">
                <span class="badge <%= r.bobotPoin >= 20 ? 'badge-danger' : r.bobotPoin >= 10 ? 'badge-warning' : 'badge-info' %>">
                  <%= r.bobotPoin %> poin
                </span>
              </td>
              <td class="px-5 py-3 text-gray-600"><%= r.sanksiDefault %></td>
              <td class="px-5 py-3">
                <div class="flex items-center justify-center gap-1">
                  <button onclick="editRule(<%= r.id %>, '<%= r.namaPelanggaran %>', <%= r.bobotPoin %>, '<%= r.sanksiDefault %>')"
                    class="p-1.5 rounded-lg hover:bg-blue-50 text-blue-600 transition" title="Edit">
                    <i data-lucide="pencil" class="w-4 h-4"></i>
                  </button>
                  <form action="/admin/rules/<%= r.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Yakin hapus?')">
                    <button type="submit" class="p-1.5 rounded-lg hover:bg-red-50 text-red-600 transition" title="Hapus">
                      <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="fixed inset-0 bg-black/40 z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl p-6 w-full max-w-md shadow-2xl">
    <h3 class="text-lg font-bold text-gray-800 mb-4">Edit Aturan Pelanggaran</h3>
    <form id="editForm" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Pelanggaran</label>
        <input type="text" name="namaPelanggaran" id="editNama" required
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Bobot Poin</label>
        <input type="number" name="bobotPoin" id="editPoin" required min="1"
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Sanksi Default</label>
        <input type="text" name="sanksiDefault" id="editSanksi" required
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm">
      </div>
      <div class="flex gap-3">
        <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-medium">Simpan</button>
        <button type="button" onclick="closeModal()" class="px-5 py-2.5 bg-gray-100 text-gray-600 rounded-xl text-sm font-medium">Batal</button>
      </div>
    </form>
  </div>
</div>

<script>
  lucide.createIcons();

  function editRule(id, nama, poin, sanksi) {
    document.getElementById('editForm').action = '/admin/rules/' + id;
    document.getElementById('editNama').value = nama;
    document.getElementById('editPoin').value = poin;
    document.getElementById('editSanksi').value = sanksi;
    document.getElementById('editModal').classList.remove('hidden');
  }

  function closeModal() {
    document.getElementById('editModal').classList.add('hidden');
  }
</script>
