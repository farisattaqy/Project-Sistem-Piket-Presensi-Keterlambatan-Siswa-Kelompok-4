<!-- Admin - Form Tambah/Edit Siswa -->
<div class="max-w-2xl mx-auto space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-800"><%= isEdit ? 'Edit Siswa' : 'Tambah Siswa Baru' %></h1>
    <p class="text-sm text-gray-500"><%= isEdit ? 'Perbarui data siswa' : 'Isi form untuk menambahkan siswa baru' %></p>
  </div>

  <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
    <form action="<%= isEdit ? '/admin/students/' + student.id : '/admin/students' %>" method="POST" class="space-y-5">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">NISN <span class="text-red-400">*</span></label>
          <input type="text" name="nisn" value="<%= isEdit ? student.nisn : '' %>" required
            class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500"
            placeholder="Contoh: 0081234567">
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Nama Lengkap <span class="text-red-400">*</span></label>
          <input type="text" name="nama" value="<%= isEdit ? student.nama : '' %>" required
            class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500"
            placeholder="Contoh: Andi Pratama">
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Kelas <span class="text-red-400">*</span></label>
        <select name="classId" required
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
          <option value="">Pilih Kelas</option>
          <% classes.forEach(c => { %>
            <option value="<%= c.id %>" <%= isEdit && student.classId === c.id ? 'selected' : '' %>><%= c.namaKelas %> — <%= c.waliKelas %></option>
          <% }); %>
        </select>
      </div>

      <% if (!isEdit) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Username</label>
            <input type="text" name="username"
              class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500"
              placeholder="Kosongkan = NISN sebagai username">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Password</label>
            <input type="text" name="password" value="password123"
              class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500"
              placeholder="Default: password123">
          </div>
        </div>
      <% } %>

      <% if (isEdit) { %>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Total Poin Pelanggaran</label>
          <input type="number" name="totalPoin" value="<%= student.totalPoin %>" min="0"
            class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
        </div>
      <% } %>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-medium hover:bg-blue-700 transition shadow-sm flex items-center gap-2">
          <i data-lucide="save" class="w-4 h-4"></i>
          <%= isEdit ? 'Simpan Perubahan' : 'Tambah Siswa' %>
        </button>
        <a href="/admin/students" class="px-6 py-2.5 bg-gray-100 text-gray-600 rounded-xl text-sm font-medium hover:bg-gray-200 transition">
          Batal
        </a>
      </div>
    </form>
  </div>
</div>

<script>lucide.createIcons();</script>
