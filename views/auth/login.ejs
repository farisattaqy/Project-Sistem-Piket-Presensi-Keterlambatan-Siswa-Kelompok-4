<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Sistem Piket & Presensi</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <style>
    * { font-family: 'Inter', sans-serif; }
    .login-bg {
      background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #06b6d4 100%);
    }
    .glass-card {
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.3);
    }
    .float-animation {
      animation: float 6s ease-in-out infinite;
    }
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-15px); }
    }
    .quick-btn { transition: all 0.2s ease; }
    .quick-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.15); }
    .input-focus:focus { box-shadow: 0 0 0 3px rgba(59,130,246,0.2); }
  </style>
</head>
<body class="login-bg min-h-screen flex items-center justify-center p-4">

  <!-- Decorative elements -->
  <div class="fixed top-20 left-20 w-72 h-72 bg-white/5 rounded-full blur-3xl"></div>
  <div class="fixed bottom-20 right-20 w-96 h-96 bg-cyan-300/10 rounded-full blur-3xl float-animation"></div>

  <div class="w-full max-w-md relative z-10">
    <!-- Logo Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-white/20 backdrop-blur-sm rounded-2xl mb-4 float-animation">
        <i data-lucide="shield-check" class="w-8 h-8 text-white"></i>
      </div>
      <h1 class="text-2xl font-bold text-white">Sistem Piket & Presensi</h1>
      <p class="text-blue-100 text-sm mt-1">Pencatatan Keterlambatan & Kedisiplinan Siswa</p>
    </div>

    <!-- Login Card -->
    <div class="glass-card rounded-2xl p-8 shadow-2xl">
      <!-- Flash Messages -->
      <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
        <div class="mb-4 p-3 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm flex items-center gap-2">
          <i data-lucide="check-circle-2" class="w-4 h-4"></i>
          <%= success[0] %>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm flex items-center gap-2">
          <i data-lucide="alert-circle" class="w-4 h-4"></i>
          <%= error[0] %>
        </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-5">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Username</label>
          <div class="relative">
            <i data-lucide="user" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input type="text" name="username" id="username" required
              class="input-focus w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 transition"
              placeholder="Masukkan username">
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1.5">Password</label>
          <div class="relative">
            <i data-lucide="lock" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input type="password" name="password" id="password" required
              class="input-focus w-full pl-10 pr-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 transition"
              placeholder="Masukkan password">
          </div>
        </div>

        <button type="submit"
          class="w-full py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl font-semibold text-sm hover:from-blue-700 hover:to-blue-800 transition shadow-lg shadow-blue-200 flex items-center justify-center gap-2">
          <i data-lucide="log-in" class="w-4 h-4"></i>
          Masuk ke Sistem
        </button>
      </form>

      <!-- Quick Login Buttons -->
      <div class="mt-6 pt-5 border-t border-gray-100">
        <p class="text-xs text-gray-400 text-center mb-3 font-medium uppercase tracking-wider">Akun Demo — Klik untuk Login Cepat</p>
        <div class="grid grid-cols-3 gap-2">
          <button onclick="quickLogin('admin','password123')"
            class="quick-btn flex flex-col items-center gap-1.5 p-3 bg-gradient-to-br from-purple-50 to-purple-100 rounded-xl border border-purple-200 hover:border-purple-300">
            <i data-lucide="shield" class="w-5 h-5 text-purple-600"></i>
            <span class="text-xs font-semibold text-purple-700">Admin</span>
          </button>
          <button onclick="quickLogin('gurupiket','password123')"
            class="quick-btn flex flex-col items-center gap-1.5 p-3 bg-gradient-to-br from-green-50 to-green-100 rounded-xl border border-green-200 hover:border-green-300">
            <i data-lucide="user-check" class="w-5 h-5 text-green-600"></i>
            <span class="text-xs font-semibold text-green-700">Guru Piket</span>
          </button>
          <button onclick="quickLogin('siswa','password123')"
            class="quick-btn flex flex-col items-center gap-1.5 p-3 bg-gradient-to-br from-amber-50 to-amber-100 rounded-xl border border-amber-200 hover:border-amber-300">
            <i data-lucide="graduation-cap" class="w-5 h-5 text-amber-600"></i>
            <span class="text-xs font-semibold text-amber-700">Siswa</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <p class="text-center text-blue-200/60 text-xs mt-6">
      © 2024 Sistem Piket & Presensi Keterlambatan Siswa
    </p>
  </div>

  <script>
    lucide.createIcons();

    function quickLogin(username, password) {
      document.getElementById('username').value = username;
      document.getElementById('password').value = password;
      document.querySelector('form').submit();
    }
  </script>
</body>
</html>
