<!-- Guru Piket Dashboard -->
<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Dashboard Piket</h1>
      <p class="text-sm text-gray-500"><%= today %></p>
    </div>
    <a href="/guru-piket/input-terlambat" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-medium hover:bg-blue-700 transition shadow-sm">
      <i data-lucide="user-plus" class="w-4 h-4"></i> Catat Siswa Terlambat
    </a>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="card-hover bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Terlambat Hari Ini</p>
          <p class="text-3xl font-bold text-gray-800 mt-1"><%= totalHariIni %></p>
        </div>
        <div class="w-12 h-12 bg-orange-50 rounded-xl flex items-center justify-center">
          <i data-lucide="alarm-clock" class="w-6 h-6 text-orange-500"></i>
        </div>
      </div>
    </div>

    <div class="card-hover bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Sudah Diizinkan</p>
          <p class="text-3xl font-bold text-green-600 mt-1"><%= diizinkan %></p>
        </div>
        <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center">
          <i data-lucide="check-circle" class="w-6 h-6 text-green-500"></i>
        </div>
      </div>
    </div>

    <div class="card-hover bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Menunggu Proses</p>
          <p class="text-3xl font-bold text-amber-600 mt-1"><%= menunggu %></p>
        </div>
        <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center">
          <i data-lucide="hourglass" class="w-6 h-6 text-amber-500"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Daftar Keterlambatan Hari Ini -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm">
    <div class="p-5 border-b border-gray-50 flex items-center justify-between">
      <h3 class="text-sm font-semibold text-gray-700 flex items-center gap-2">
        <i data-lucide="list" class="w-4 h-4 text-blue-500"></i>
        Daftar Keterlambatan Hari Ini
      </h3>
      <a href="/guru-piket/rekap" class="text-xs text-blue-600 hover:underline flex items-center gap-1">
        <i data-lucide="file-text" class="w-3 h-3"></i> Lihat Rekap Lengkap
      </a>
    </div>

    <% if (terlambatHariIni.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">No</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Siswa</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Kelas</th>
              <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Jam Masuk</th>
              <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Telat</th>
              <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Alasan</th>
              <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Status</th>
              <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            <% terlambatHariIni.forEach((r, i) => { %>
              <tr class="hover:bg-gray-50 transition">
                <td class="px-5 py-3 text-gray-500"><%= i + 1 %></td>
                <td class="px-5 py-3">
                  <p class="font-medium text-gray-800"><%= r.student.nama %></p>
                  <p class="text-[11px] text-gray-400 font-mono"><%= r.student.nisn %></p>
                </td>
                <td class="px-5 py-3 text-gray-600"><%= r.student.class.namaKelas %></td>
                <td class="px-5 py-3 text-center font-mono text-gray-700"><%= r.jamMasuk %></td>
                <td class="px-5 py-3 text-center">
                  <span class="badge <%= r.menitTelat > 30 ? 'badge-danger' : r.menitTelat > 15 ? 'badge-warning' : 'badge-info' %>">
                    <%= r.menitTelat %> menit
                  </span>
                </td>
                <td class="px-5 py-3 text-gray-600 max-w-[150px] truncate"><%= r.alasan %></td>
                <td class="px-5 py-3 text-center">
                  <% if (r.statusIzin === 'DIIZINKAN') { %>
                    <span class="badge badge-success">DIIZINKAN</span>
                  <% } else { %>
                    <span class="badge badge-warning">MENUNGGU</span>
                  <% } %>
                </td>
                <td class="px-5 py-3">
                  <div class="flex items-center justify-center gap-1">
                    <a href="/guru-piket/surat-izin/<%= r.id %>" class="p-1.5 rounded-lg hover:bg-blue-50 text-blue-600 transition" title="Lihat Surat Izin">
                      <i data-lucide="file-badge" class="w-4 h-4"></i>
                    </a>
                    <% if (r.statusIzin === 'MENUNGGU') { %>
                      <form action="/guru-piket/status-izin/<%= r.id %>" method="POST" class="inline">
                        <input type="hidden" name="statusIzin" value="DIIZINKAN">
                        <button type="submit" class="p-1.5 rounded-lg hover:bg-green-50 text-green-600 transition" title="Izinkan">
                          <i data-lucide="check" class="w-4 h-4"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="p-12 text-center text-gray-400">
        <i data-lucide="smile" class="w-12 h-12 mx-auto mb-3 text-green-400"></i>
        <p class="text-sm font-medium">Tidak ada siswa terlambat hari ini</p>
        <p class="text-xs mt-1">Semua siswa datang tepat waktu 🎉</p>
      </div>
    <% } %>
  </div>
</div>

<script>lucide.createIcons();</script>
