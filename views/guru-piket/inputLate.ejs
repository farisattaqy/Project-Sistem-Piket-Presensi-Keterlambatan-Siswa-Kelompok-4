<!-- Guru Piket - Input Keterlambatan -->
<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Catat Keterlambatan Siswa</h1>
    <p class="text-sm text-gray-500">Cari siswa berdasarkan NISN atau nama, lalu catat keterlambatan</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Pencarian Siswa -->
    <div class="lg:col-span-1 space-y-4">
      <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
        <h3 class="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
          <i data-lucide="search" class="w-4 h-4 text-blue-500"></i> Cari Siswa
        </h3>
        <input type="text" id="searchInput" placeholder="Ketik NISN atau Nama..."
          class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 mb-3"
          autocomplete="off">
        
        <div id="searchResults" class="space-y-2 max-h-96 overflow-y-auto">
          <!-- Hasil pencarian akan muncul di sini -->
          <p class="text-xs text-gray-400 text-center py-4">Ketik minimal 2 karakter untuk mencari...</p>
        </div>
      </div>
    </div>

    <!-- Form Input Keterlambatan -->
    <div class="lg:col-span-2">
      <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
        <h3 class="text-sm font-semibold text-gray-700 mb-4 flex items-center gap-2">
          <i data-lucide="clipboard-edit" class="w-4 h-4 text-orange-500"></i> Form Pencatatan Keterlambatan
        </h3>

        <!-- Info siswa terpilih -->
        <div id="selectedStudentInfo" class="mb-5 p-4 bg-blue-50 border border-blue-200 rounded-xl hidden">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-blue-200 flex items-center justify-center text-blue-700 font-bold" id="studentInitial">-</div>
            <div>
              <p class="font-semibold text-gray-800" id="studentName">-</p>
              <p class="text-xs text-gray-500"><span id="studentNisn">-</span> · <span id="studentClass">-</span> · Poin: <span id="studentPoin" class="font-bold">0</span></p>
            </div>
          </div>
        </div>

        <form action="/guru-piket/input-terlambat" method="POST" id="lateForm" class="space-y-4">
          <input type="hidden" name="studentId" id="studentIdInput" value="<%= selectedStudent ? selectedStudent.id : '' %>">

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Jam Masuk <span class="text-red-400">*</span></label>
              <input type="time" name="jamMasuk" required value="<%= new Date().toTimeString().slice(0,5) %>"
                class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Menit Terlambat <span class="text-red-400">*</span></label>
              <input type="number" name="menitTelat" id="menitTelat" required min="1" placeholder="Contoh: 20"
                class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1.5">Alasan Keterlambatan <span class="text-red-400">*</span></label>
            <textarea name="alasan" required rows="2" placeholder="Contoh: Ban bocor di jalan, hujan deras..."
              class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500 resize-none"></textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Sanksi</label>
              <select name="sanksi" id="sanksiSelect"
                class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
                <option value="">Pilih Sanksi</option>
                <option value="Teguran Lisan">Teguran Lisan</option>
                <option value="Bersihkan Halaman">Bersihkan Halaman</option>
                <option value="Bersihkan Toilet">Bersihkan Toilet</option>
                <option value="Bersihkan Lapangan">Bersihkan Lapangan</option>
                <option value="Panggilan Orang Tua">Panggilan Orang Tua</option>
                <option value="Surat Peringatan">Surat Peringatan</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1.5">Poin Pelanggaran</label>
              <input type="number" name="poinDiberikan" id="poinInput" min="0" value="0" placeholder="0"
                class="w-full px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
              <!-- Saran poin -->
              <p class="text-[11px] text-gray-400 mt-1" id="poinSuggestion">Poin akan diisi otomatis berdasarkan menit terlambat</p>
            </div>
          </div>

          <div class="pt-2">
            <button type="submit" id="submitBtn" disabled
              class="w-full py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl font-semibold text-sm hover:from-blue-700 hover:to-blue-800 transition shadow-lg shadow-blue-200 flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
              <i data-lucide="save" class="w-4 h-4"></i>
              Simpan & Terbitkan Surat Izin Masuk Kelas
            </button>
          </div>
        </form>
      </div>

      <!-- Referensi Aturan Poin -->
      <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm mt-4">
        <h3 class="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2">
          <i data-lucide="book-open" class="w-4 h-4 text-amber-500"></i> Referensi Aturan Poin
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <% rules.forEach(r => { %>
            <div class="flex items-center justify-between p-2 bg-gray-50 rounded-lg text-xs">
              <span class="text-gray-600"><%= r.namaPelanggaran %></span>
              <span class="badge <%= r.bobotPoin >= 20 ? 'badge-danger' : r.bobotPoin >= 10 ? 'badge-warning' : 'badge-info' %>">
                <%= r.bobotPoin %> poin
              </span>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  lucide.createIcons();

  const searchInput = document.getElementById('searchInput');
  const searchResults = document.getElementById('searchResults');
  const studentIdInput = document.getElementById('studentIdInput');
  const submitBtn = document.getElementById('submitBtn');
  const menitTelat = document.getElementById('menitTelat');
  const poinInput = document.getElementById('poinInput');
  const sanksiSelect = document.getElementById('sanksiSelect');

  // Pencarian siswa (AJAX)
  let searchTimeout;
  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimeout);
    const q = this.value.trim();
    
    if (q.length < 2) {
      searchResults.innerHTML = '<p class="text-xs text-gray-400 text-center py-4">Ketik minimal 2 karakter untuk mencari...</p>';
      return;
    }

    searchTimeout = setTimeout(async () => {
      try {
        const res = await fetch(`/guru-piket/search-student?q=${encodeURIComponent(q)}`);
        const students = await res.json();
        
        if (students.length === 0) {
          searchResults.innerHTML = '<p class="text-xs text-gray-400 text-center py-4">Siswa tidak ditemukan</p>';
          return;
        }

        searchResults.innerHTML = students.map(s => `
          <button type="button" onclick='selectStudent(${JSON.stringify(s).replace(/'/g, "&#39;")})'
            class="w-full flex items-center gap-3 p-3 rounded-lg hover:bg-blue-50 border border-gray-100 transition text-left">
            <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 text-xs font-bold">
              ${s.nama.charAt(0)}
            </div>
            <div class="flex-1">
              <p class="text-sm font-medium text-gray-800">${s.nama}</p>
              <p class="text-[11px] text-gray-400">${s.nisn} · ${s.class.namaKelas} · Poin: ${s.totalPoin}</p>
            </div>
          </button>
        `).join('');
      } catch (err) {
        console.error('Search error:', err);
      }
    }, 300);
  });

  // Pilih siswa
  function selectStudent(student) {
    studentIdInput.value = student.id;
    document.getElementById('selectedStudentInfo').classList.remove('hidden');
    document.getElementById('studentInitial').textContent = student.nama.charAt(0);
    document.getElementById('studentName').textContent = student.nama;
    document.getElementById('studentNisn').textContent = student.nisn;
    document.getElementById('studentClass').textContent = student.class.namaKelas;
    document.getElementById('studentPoin').textContent = student.totalPoin;
    submitBtn.disabled = false;

    // Highlight selected
    searchResults.querySelectorAll('button').forEach(btn => btn.classList.remove('bg-blue-50', 'border-blue-300'));
    event.currentTarget.classList.add('bg-blue-50', 'border-blue-300');
  }

  // Auto-suggest poin berdasarkan menit terlambat
  menitTelat.addEventListener('input', function() {
    const menit = parseInt(this.value) || 0;
    let poin = 0;
    let sanksi = '';
    
    if (menit >= 60) { poin = 25; sanksi = 'Panggilan Orang Tua'; }
    else if (menit >= 31) { poin = 15; sanksi = 'Bersihkan Toilet'; }
    else if (menit >= 16) { poin = 10; sanksi = 'Bersihkan Halaman'; }
    else if (menit >= 1) { poin = 5; sanksi = 'Teguran Lisan'; }

    poinInput.value = poin;
    sanksiSelect.value = sanksi;
    document.getElementById('poinSuggestion').textContent = `Saran: ${poin} poin (${sanksi})`;
  });

  <% if (selectedStudent) { %>
    // Auto-select jika ada studentId dari query
    selectStudent(<%= JSON.stringify(selectedStudent) %>);
  <% } %>
</script>
