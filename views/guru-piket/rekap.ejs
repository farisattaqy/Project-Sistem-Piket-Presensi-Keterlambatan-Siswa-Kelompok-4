<!-- Guru Piket - Rekap Piket -->
<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">Rekap Piket</h1>
      <p class="text-sm text-gray-500"><%= periodeLabel %></p>
    </div>
    <button onclick="window.print()" class="no-print inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-medium hover:bg-blue-700 transition shadow-sm">
      <i data-lucide="printer" class="w-4 h-4"></i> Cetak Rekap
    </button>
  </div>

  <!-- Filter -->
  <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm no-print">
    <form method="GET" action="/guru-piket/rekap" class="flex flex-col sm:flex-row gap-3 items-end">
      <div>
        <label class="block text-xs font-semibold text-gray-500 mb-1">Periode</label>
        <select name="periode" onchange="toggleTanggal(this.value)"
          class="px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
          <option value="harian" <%= periode === 'harian' ? 'selected' : '' %>>Harian</option>
          <option value="mingguan" <%= periode === 'mingguan' ? 'selected' : '' %>>Mingguan (7 Hari)</option>
        </select>
      </div>
      <div id="tanggalField">
        <label class="block text-xs font-semibold text-gray-500 mb-1">Tanggal</label>
        <input type="date" name="tanggal" value="<%= tanggal %>"
          class="px-4 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:border-blue-500">
      </div>
      <button type="submit" class="px-5 py-2.5 bg-gray-100 text-gray-700 rounded-xl text-sm font-medium hover:bg-gray-200 transition">
        <i data-lucide="filter" class="w-4 h-4 inline"></i> Tampilkan
      </button>
    </form>
  </div>

  <!-- Summary -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm text-center">
      <p class="text-xs text-gray-400 uppercase font-medium">Total Siswa Terlambat</p>
      <p class="text-2xl font-bold text-gray-800 mt-1"><%= records.length %></p>
    </div>
    <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm text-center">
      <p class="text-xs text-gray-400 uppercase font-medium">Rata-rata Telat</p>
      <p class="text-2xl font-bold text-orange-600 mt-1"><%= avgTelat %> menit</p>
    </div>
    <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm text-center">
      <p class="text-xs text-gray-400 uppercase font-medium">Total Poin Diberikan</p>
      <p class="text-2xl font-bold text-red-600 mt-1"><%= totalPoin %></p>
    </div>
  </div>

  <!-- Tabel Rekap -->
  <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden print-container">
    <!-- Print Header -->
    <div class="print-only p-6 text-center border-b-2 border-gray-800">
      <h2 class="text-lg font-bold uppercase">REKAPITULASI PIKET <%= periode === 'mingguan' ? 'MINGGUAN' : 'HARIAN' %></h2>
      <p class="text-sm text-gray-600"><%= periodeLabel %></p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-100">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">No</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Tanggal</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Siswa</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Kelas</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Jam</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Telat</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Alasan</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Sanksi</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Poin</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-gray-500 uppercase">Status</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Guru Piket</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% records.forEach((r, i) => { %>
            <tr class="hover:bg-gray-50 transition">
              <td class="px-4 py-3 text-gray-500"><%= i + 1 %></td>
              <td class="px-4 py-3 text-gray-600 text-xs whitespace-nowrap">
                <%= new Date(r.tanggal).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </td>
              <td class="px-4 py-3 font-medium text-gray-800"><%= r.student.nama %></td>
              <td class="px-4 py-3 text-gray-600"><%= r.student.class.namaKelas %></td>
              <td class="px-4 py-3 text-center font-mono text-gray-700"><%= r.jamMasuk %></td>
              <td class="px-4 py-3 text-center">
                <span class="badge <%= r.menitTelat > 30 ? 'badge-danger' : r.menitTelat > 15 ? 'badge-warning' : 'badge-info' %>"><%= r.menitTelat %> min</span>
              </td>
              <td class="px-4 py-3 text-gray-600 max-w-[120px] truncate text-xs"><%= r.alasan %></td>
              <td class="px-4 py-3 text-gray-600 text-xs"><%= r.sanksi || '-' %></td>
              <td class="px-4 py-3 text-center font-bold text-red-600">+<%= r.poinDiberikan %></td>
              <td class="px-4 py-3 text-center">
                <span class="badge <%= r.statusIzin === 'DIIZINKAN' ? 'badge-success' : 'badge-warning' %>"><%= r.statusIzin %></span>
              </td>
              <td class="px-4 py-3 text-gray-500 text-xs"><%= r.guruPiket.nama %></td>
            </tr>
          <% }); %>
          <% if (records.length === 0) { %>
            <tr>
              <td colspan="11" class="px-4 py-12 text-center text-gray-400">
                <i data-lucide="inbox" class="w-10 h-10 mx-auto mb-2"></i>
                <p>Tidak ada data untuk periode ini</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Print Footer -->
    <div class="print-only p-6 border-t border-gray-200">
      <div class="flex justify-between">
        <div>
          <p class="text-xs text-gray-500">Total: <%= records.length %> siswa terlambat</p>
          <p class="text-xs text-gray-500">Total poin: <%= totalPoin %></p>
        </div>
        <div class="text-center">
          <p class="text-xs text-gray-500 mb-10">Guru Piket,</p>
          <p class="text-sm font-semibold border-t border-gray-300 pt-1">________________</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  lucide.createIcons();

  function toggleTanggal(val) {
    document.getElementById('tanggalField').style.display = val === 'mingguan' ? 'none' : 'block';
  }
  // Init
  toggleTanggal('<%= periode %>');
</script>
