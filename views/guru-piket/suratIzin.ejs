<!-- Surat Izin Masuk Kelas Digital -->
<% const layoutClass = (typeof printMode !== 'undefined' && printMode) ? '' : ''; %>

<div class="max-w-2xl mx-auto space-y-4">
  <!-- Action Buttons (No Print) -->
  <div class="flex items-center justify-between no-print">
    <a href="javascript:history.back()" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700">
      <i data-lucide="arrow-left" class="w-4 h-4"></i> Kembali
    </a>
    <button onclick="window.print()" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-medium hover:bg-blue-700 transition shadow-sm">
      <i data-lucide="printer" class="w-4 h-4"></i> Cetak Surat Izin
    </button>
  </div>

  <!-- Surat Izin -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm print-container" id="suratIzin">
    <!-- Header Surat -->
    <div class="border-b-2 border-gray-800 p-6 text-center">
      <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wide">SURAT IZIN MASUK KELAS</h2>
      <p class="text-xs text-gray-500 mt-1">Sistem Piket & Presensi Keterlambatan Siswa</p>
      <p class="text-xs text-gray-400">No. Ref: PIK-<%= record.id %>-<%= new Date(record.tanggal).getFullYear() %></p>
    </div>

    <!-- Body Surat -->
    <div class="p-6 space-y-5">
      <!-- Status Badge -->
      <div class="text-center">
        <% if (record.statusIzin === 'DIIZINKAN') { %>
          <span class="inline-flex items-center gap-2 px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm font-semibold">
            <i data-lucide="check-circle" class="w-4 h-4"></i> DIIZINKAN MASUK KELAS
          </span>
        <% } else { %>
          <span class="inline-flex items-center gap-2 px-4 py-2 bg-amber-100 text-amber-700 rounded-full text-sm font-semibold">
            <i data-lucide="clock" class="w-4 h-4"></i> MENUNGGU PERSETUJUAN
          </span>
        <% } %>
      </div>

      <!-- Data Siswa -->
      <div class="bg-gray-50 rounded-xl p-4">
        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Data Siswa</h4>
        <table class="w-full text-sm">
          <tr>
            <td class="py-1.5 text-gray-500 w-40">Nama Lengkap</td>
            <td class="py-1.5 font-semibold text-gray-800">: <%= record.student.nama %></td>
          </tr>
          <tr>
            <td class="py-1.5 text-gray-500">NISN</td>
            <td class="py-1.5 font-mono text-gray-800">: <%= record.student.nisn %></td>
          </tr>
          <tr>
            <td class="py-1.5 text-gray-500">Kelas</td>
            <td class="py-1.5 text-gray-800">: <%= record.student.class.namaKelas %></td>
          </tr>
        </table>
      </div>

      <!-- Detail Keterlambatan -->
      <div class="bg-orange-50 rounded-xl p-4">
        <h4 class="text-xs font-semibold text-orange-600 uppercase tracking-wider mb-3">Detail Keterlambatan</h4>
        <table class="w-full text-sm">
          <tr>
            <td class="py-1.5 text-gray-500 w-40">Tanggal</td>
            <td class="py-1.5 text-gray-800">: <%= new Date(record.tanggal).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></td>
          </tr>
          <tr>
            <td class="py-1.5 text-gray-500">Jam Masuk</td>
            <td class="py-1.5 font-mono font-semibold text-gray-800">: <%= record.jamMasuk %> WIB</td>
          </tr>
          <tr>
            <td class="py-1.5 text-gray-500">Keterlambatan</td>
            <td class="py-1.5 text-gray-800">: <span class="font-bold text-orange-600"><%= record.menitTelat %> menit</span></td>
          </tr>
          <tr>
            <td class="py-1.5 text-gray-500">Alasan</td>
            <td class="py-1.5 text-gray-800">: <%= record.alasan %></td>
          </tr>
          <% if (record.sanksi) { %>
          <tr>
            <td class="py-1.5 text-gray-500">Sanksi</td>
            <td class="py-1.5 text-gray-800">: <span class="badge badge-warning"><%= record.sanksi %></span></td>
          </tr>
          <% } %>
          <tr>
            <td class="py-1.5 text-gray-500">Poin Pelanggaran</td>
            <td class="py-1.5 text-gray-800">: <span class="font-bold text-red-600">+<%= record.poinDiberikan %> poin</span></td>
          </tr>
        </table>
      </div>

      <!-- Catatan -->
      <div class="bg-blue-50 rounded-xl p-4 text-sm text-blue-800">
        <p class="font-semibold mb-1">📋 Catatan untuk Guru Pengajar:</p>
        <p class="text-xs">Siswa yang bersangkutan telah melalui proses pencatatan di pos piket gerbang dan <strong><%= record.statusIzin === 'DIIZINKAN' ? 'DIIZINKAN' : 'masih MENUNGGU persetujuan' %></strong> untuk mengikuti kegiatan belajar mengajar di kelas. Surat ini diterbitkan secara digital dan dapat diverifikasi melalui sistem.</p>
      </div>

      <!-- Tanda Tangan -->
      <div class="grid grid-cols-2 gap-8 pt-4">
        <div class="text-center">
          <p class="text-xs text-gray-500 mb-12">Guru Piket,</p>
          <p class="text-sm font-semibold text-gray-800 border-t border-gray-300 pt-1"><%= record.guruPiket.nama %></p>
          <p class="text-[10px] text-gray-400">NIP. -</p>
        </div>
        <div class="text-center">
          <p class="text-xs text-gray-500 mb-12">Siswa,</p>
          <p class="text-sm font-semibold text-gray-800 border-t border-gray-300 pt-1"><%= record.student.nama %></p>
          <p class="text-[10px] text-gray-400">NISN. <%= record.student.nisn %></p>
        </div>
      </div>

      <!-- Footer Surat -->
      <div class="text-center pt-4 border-t border-gray-100">
        <p class="text-[10px] text-gray-400">Dicetak pada: <%= new Date().toLocaleString('id-ID') %> | Sistem Piket Digital</p>
        <p class="text-[10px] text-gray-400">Dokumen ini diterbitkan secara elektronik dan sah tanpa tanda tangan basah</p>
      </div>
    </div>
  </div>
</div>

<script>lucide.createIcons();</script>
